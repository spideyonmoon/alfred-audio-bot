# Copy to .env and fill in your Telegram credentials.
# .env is private and gitignored. On the VPS: chmod 600 .env

# Required: BotFather token and API credentials from https://my.telegram.org
BOT_TOKEN=
API_ID=
API_HASH=

# Comma-separated numeric IDs. Leave blank to allow none.
# Admins may use the bot in any chat; allowed chats permit all their members.
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=
# Example: ALLOWED_CHATS=-1001234567890,-1009876543210
ALLOWED_CHATS=

# Optional Telegraph access token for web versions of /fs reports.
TELEGRAPH_TOKEN=

# Optional tuning. Each analysis can use roughly 0.5 GB of RAM.
MAX_CONCURRENT_JOBS=1
AF_EXTRACTORS=4
PROGRESS_UPDATE_INTERVAL=8.0
