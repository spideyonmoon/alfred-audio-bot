# Alfred — environment file for a VPS (or any host).
#
# Copy to `.env` and fill in the three required values:
#     cp .env.example .env && nano .env
#
# `.env` is gitignored and must never be committed — it holds the bot's credentials.
# Keep it readable only by you:  chmod 600 .env
#
# The bot reads this file directly (python-dotenv), so no shell exporting is needed.

# ---------------------------------------------------------------------------
# Required — from Telegram. The bot will not start without all three.
# ---------------------------------------------------------------------------

# BotFather (https://t.me/BotFather) → /newbot, or /mybots → API Token.
# Looks like  1234567890:AAH...   The whole thing, including the colon.
BOT_TOKEN=

# https://my.telegram.org → API Development Tools → create an app.
# API_ID is a number (no quotes); API_HASH is a 32-character hex string.
API_ID=
API_HASH=

# ---------------------------------------------------------------------------
# Access control — who may use the bot.
#
# Leave both ALLOWED_* empty and the bot answers nobody except the ADMIN_IDS below.
# These are JSON, so mind the quotes and commas.
# ---------------------------------------------------------------------------

# Admins bypass every chat/topic check. JSON array of numeric user IDs.
# Get an ID by forwarding a message to @userinfobot.
#   ADMIN_IDS=[123456789]
ADMIN_IDS=[]

# Chats (and, inside them, forum topics) allowed to use the bot.
# 0 means the chat's general (non-topic) area. Leave [] to allow none.
#   ALLOWED_CHATS={"-1001234567890": [0, 123, 456]}
ALLOWED_CHATS={}

# Extra topic IDs allowed anywhere, when you don't want to name the chat.
#   ALLOWED_TOPICS=[]
ALLOWED_TOPICS=[]

# ---------------------------------------------------------------------------
# Optional — behaviour and resource tuning. Defaults are safe; delete to use them.
# ---------------------------------------------------------------------------

# How many files are analysed at once. ONE analysis peaks around 400-500 MB of RAM
# (measured on a 7-minute FLAC), and every worker can run one, so this is the setting
# that decides whether the host survives.
#
#   VPS RAM     use
#   1 GB        1
#   2 GB        1-2
#   4 GB+       2-4
#
# Raise it only if you have watched the memory actually stay low. This is the exact
# setting whose old default of 4 was killing the 512 MB free instance.
MAX_CONCURRENT_JOBS=1

# Session storage.
#
#   1 = keep it in memory (recommended here). Each restart re-logs in with the bot
#       token automatically, which costs a few seconds, and it avoids a startup crash:
#       Pyrogram writes a .session file into the working directory, and inside a
#       container that directory belongs to root — a non-root process cannot create a
#       file there, and the bot dies with
#       "sqlite3.OperationalError: unable to open database file".
#   0 = use a file (persists the session). Only viable outside Docker, or in a container
#       where the app directory is writable by the running user.
#   unset = decide automatically (in memory on the cloud platforms, file on a plain host,
#       which is fine when you are not containerised).
SESSION_IN_MEMORY=1

# Health HTTP endpoint, used by hosting platforms to probe the service. Harmless on a
# VPS — it is not published to the host unless you add a `ports:` mapping in
# docker-compose.yml. Set 0 to turn it off entirely.
#HEALTH_SERVER=1

# Port for that endpoint. Only matters if you publish it.
#HEALTH_PORT=7860

# Extractor processes per analysis (loudness, spectrogram, bit depth). The default of 4
# is fine everywhere: measured, the children cost only ~30 MB in total, so this is not a
# memory lever. Lowering it only makes each analysis slower.
#AF_EXTRACTORS=4

# Seconds between progress-message edits on Telegram. Raise it if you hit FloodWait.
#PROGRESS_UPDATE_INTERVAL=8.0

# ---------------------------------------------------------------------------
# Optional — full text reports uploaded to telegra.ph (used by /fs -info).
# ---------------------------------------------------------------------------

# https://telegra.ph/api → create an account → access_token.
# Without it, the forensic text report is still sent, just not as a web page.
TELEGRAPH_TOKEN=
